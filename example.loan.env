
# ── Micro-loan eligibility feature ──────────────────────────────────────────
# Master switch (feature is fully inert unless enabled).
# LOAN_FEATURE_ENABLED=false
# Per-check toggles — a DISABLED check is bypassed (treated as pass) so product
# can test end-to-end without real Amul submissions / bank-list rows.
# LOAN_CHECK_BANK_LIST_ENABLED=true
# LOAN_CHECK_MILK_ENABLED=true
# LOAN_CHECK_ALREADY_AVAILED_ENABLED=true
# Loan params (script: up to ₹5,000 if last-month milk ≥ ₹3,000).
# LOAN_MAX_AMOUNT=5000
# LOAN_INTEREST_RATE_PCT=7
# LOAN_MILK_THRESHOLD=3000
# LOAN_MILK_LOOKBACK_DAYS=30
# LOAN_CODE_LENGTH=6
# LOAN_CODE_EXPIRY_DAYS=0
# Postgres for loan tables (SQLAlchemy async URL — asyncpg driver). SECRET.
# LOAN_DB_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# LOAN_DB_POOL_SIZE=5
# Onex-Aura / OneXtel SMS gateway (DLT-approved KDCC micro-loan template).
# When LOAN_SMS_ENABLED=false, SMS is a dry-run (code still issued+stored).
# LOAN_SMS_ENABLED=false
# ONEX_SMS_BASE_URL=https://sapi.onex-aura.com/api/sms
# ONEX_SMS_KEY=                 # SECRET
# ONEX_SMS_FROM=AMULHO
# ONEX_SMS_ENTITY_ID=           # SECRET (DLT entity id)
# ONEX_SMS_TEMPLATE_ID=         # SECRET (DLT template id)
# ONEX_SMS_TIMEOUT_SECS=15
# ONEX_SMS_BODY_TEMPLATE={name}, ... ₹{amount} ... :{code} .   # Gujarati DLT body; placeholders {name} {amount} {code}
