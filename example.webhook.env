
# ── Partner heat-alert webhook ──────────────────────────────────────────────
# Shared secret the partner sends in the X-Webhook-Token request header.
# When unset/empty the endpoint rejects all requests (fail closed). SECRET.
# WEBHOOK_SHARED_TOKEN=

# Dedicated Postgres for webhook payloads (hosted on vm2).
# SQLAlchemy async URL with asyncpg driver. SECRET.
# Example: postgresql+asyncpg://webhook_user:pass@10.x.x.x:5432/webhook_db
# WEBHOOK_DB_URL=postgresql+asyncpg://user:pass@host:5432/webhook_db
# WEBHOOK_DB_POOL_SIZE=5

# Retention + cleanup cadence (background worker hard-deletes expired rows).
# WEBHOOK_RETENTION_HOURS=24
# WEBHOOK_CLEANUP_INTERVAL_SECONDS=900
