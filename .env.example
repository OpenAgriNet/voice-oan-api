

# --- Core application ---
ENVIRONMENT=
SECRET_KEY=secret-key
ALLOWED_ORIGINS=*

# --- JWT auth (RS256) ---
JWT_PUBLIC_KEY_PATH=
JWT_PRIVATE_KEY_PATH=

# --- Redis (session/cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0


# Azure OpenAI (required if LLM_PROVIDER=azure-openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Self-hosted inference endpoint (optional alternative provider)
INFERENCE_ENDPOINT_URL=
INFERENCE_API_KEY=

# --- Search / retrieval (Marqo) ---
MARQO_ENDPOINT_URL=
MARQO_INDEX_NAME=
OLLAMA_ENDPOINT_URL=

# --- Translation (Bhashini) ---
MEITY_API_KEY_VALUE=
BHASHINI_TRANSLATE_MAX_PARALLEL=
BHASHINI_TRANSLATE_CHUNK_MAX_SENTENCES=
BHASHINI_TRANSLATE_CHUNKING_MIN_CHARS=

# --- Maps ---
MAPBOX_API_TOKEN=

# --- Beckn network (BAP/BPP) ---
BAP_ENDPOINT=
BAP_ID=
BAP_URI=
POCRA_BPP_ID=
POCRA_BPP_URI=

# --- AWS (S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
TELEMETRY_API_URL=
NUDGE_API_URL=


